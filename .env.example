# Supabase (project houseofmenzura, ca-central-1). The service role key stays on the server only.
SUPABASE_URL=https://lqmmpufyuonbtvhwoudx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional: table id of public.applications, so the email link opens the right table.
SUPABASE_APPLICATIONS_TABLE_ID=17637
# Resend, sending from the verified houseofmenzura.com domain
RESEND_API_KEY=
HOUSE_NOTIFY_EMAIL=
# Cloudflare Turnstile. Outside production, Cloudflare's always-pass test keys are used when these are empty.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Vercel Cron sends this as a bearer token to /api/cron/retention
CRON_SECRET=
# Local tests only: swaps Supabase, Resend and Turnstile for in-memory stand-ins. Ignored on Vercel.
HOM_TEST_MODE=
